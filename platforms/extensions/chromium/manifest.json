{
  "manifest_version": 3,
  "name": "Tetris \u2014 Shared Session",
  "version": "0.10.1",
  "description": "Keyboard Tetris in a sidebar. Local settings and browser-session play.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open Tetris"
  },
  "icons": {
    "16": "icons/tetris-16.png",
    "32": "icons/tetris-32.png",
    "48": "icons/tetris-48.png",
    "128": "icons/tetris-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
